# Copia este archivo como ".env" en la carpeta frontend/ y ajusta los valores
# según el hospital/sitio donde se despliegue.

# URL del backend
VITE_API_URL=http://localhost:8000

# Nombre visible de la aplicación (branding)
VITE_APP_NAME=Panel de Impresoras

# Porcentaje de tóner a partir del cual se marca como "tóner bajo" en la UI
VITE_LOW_TONER_THRESHOLD=15
