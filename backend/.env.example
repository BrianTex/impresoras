# Copia este archivo como ".env" en la carpeta backend/ y ajusta los valores
# según el hospital/sitio donde se despliegue.

# Nombre visible de la aplicación (branding, aparece en /health y en el título de la API)
APP_NAME=Panel de Impresoras

# Host y puerto donde escucha el backend
HOST=0.0.0.0
PORT=8000

# Cada cuánto tiempo (en segundos) se refrescan automáticamente TODAS las impresoras
# 3600 = cada hora. Bájalo si necesitas datos más frescos (ej. 900 = cada 15 min)
SCRAPE_INTERVAL_SECONDS=3600

# Porcentaje de tóner a partir del cual se registra una advertencia en el log
LOW_TONER_THRESHOLD=15

# Orígenes permitidos para CORS, separados por comas.
# En desarrollo puedes dejar "*". En producción, restringe a tu dominio/IP real, ej:
# CORS_ORIGINS=http://10.30.20.5:5173,http://panel-impresoras.hospital.local
CORS_ORIGINS=*

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Cadena de conexión a la base de datos. Por defecto, SQLite local.
DATABASE_URL=sqlite:///./printers.db
